<Window x:Class="FreePresenter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FreePresenter 운영 화면"
        Width="1000"
        Height="650"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="FreePresenter"
                   FontSize="30"
                   FontWeight="Bold"
                   Margin="0,0,0,18"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 슬라이드 목록 -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="슬라이드 목록"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <ListBox x:Name="SlidesList"
                         Height="450"
                         SelectionChanged="SlidesList_SelectionChanged"/>

                <Button Content="선택한 슬라이드 삭제"
                        Height="38"
                        Margin="0,10,0,0"
                        Click="DeleteSlide_Click"/>
            </StackPanel>

            <!-- 슬라이드 편집 영역 -->
            <StackPanel Grid.Column="1"
                        Margin="24,0,0,0">

                <TextBlock Text="슬라이드 제목"
                           FontSize="16"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="TitleInput"
                         Height="38"
                         FontSize="16"
                         Padding="8"
                         Margin="0,0,0,18"/>

                <TextBlock Text="화면에 표시할 내용"
                           FontSize="16"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="ContentInput"
                         Height="300"
                         FontSize="20"
                         Padding="10"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>

                <WrapPanel Margin="0,18,0,0">
                    <Button Content="새 슬라이드 추가"
                            Width="150"
                            Height="42"
                            Margin="0,0,10,10"
                            Click="AddSlide_Click"/>

                    <Button Content="선택한 슬라이드 수정"
                            Width="170"
                            Height="42"
                            Margin="0,0,10,10"
                            Click="UpdateSlide_Click"/>

                    <Button Content="출력 화면에 표시"
                            Width="160"
                            Height="42"
                            Margin="0,0,10,10"
                            Click="ShowOutput_Click"/>
                </WrapPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
