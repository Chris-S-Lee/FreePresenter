<Window x:Class="FreePresenter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FreePresenter"
        Width="1200"
        Height="780"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="FreePresenter"
                       FontSize="30"
                       FontWeight="Bold"/>
            <TextBlock Text="가사를 입력하세요. 빈 줄마다 새 슬라이드가 만들어집니다."
                       FontSize="14"
                       Foreground="#666666"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="0.85*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0"
                  Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="LyricsInput"
                         FontSize="17"
                         Padding="12"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         VerticalContentAlignment="Top"
                         ToolTip="빈 줄을 넣으면 그 지점에서 새 슬라이드로 나뉩니다."/>

                <Button Grid.Row="1"
                        Content="슬라이드 만들기"
                        Height="46"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Margin="0,14,0,0"
                        Click="GenerateSlides_Click"/>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="SlideCountText"
                           Text="슬라이드 목록"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <ListBox x:Name="SlidesList"
                         Grid.Row="1"
                         FontSize="16"
                         SelectionChanged="SlidesList_SelectionChanged"/>

                <Button Grid.Row="2"
                        Content="선택한 슬라이드 출력"
                        Height="46"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Margin="0,14,0,0"
                        Click="ShowOutput_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
