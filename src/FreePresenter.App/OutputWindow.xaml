<Window x:Class="FreePresenter.App.OutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="출력 화면"
        Width="1280"
        Height="720"
        MinWidth="800"
        MinHeight="450"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0"
                                EndPoint="1,1">
                <GradientStop Color="#172A74" Offset="0"/>
                <GradientStop Color="#302B63" Offset="0.5"/>
                <GradientStop Color="#6A11CB" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <TextBlock x:Name="LyricsText"
                    Margin="70,45,70,40"
                    Foreground="White"
                    FontSize="48"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    LineStackingStrategy="BlockLineHeight"
                    LineHeight="68"/>
    </Grid>
</Window>